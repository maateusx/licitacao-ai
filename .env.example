# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Gemini (usado a partir do Sprint 2)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_RATE_LIMIT_MS=250
CLASSIFIER_MAX_RETRIES=2

# Pipeline
PNCP_RATE_LIMIT_MS=1000
PNCP_MAX_PAGES_PER_KEYWORD=20
# Identificação do cliente HTTP enviada ao PNCP. Personalize como quiser —
# o ideal é se identificar de forma honesta, ex.: "minha-empresa-bot/1.0 (+contato)".
PNCP_USER_AGENT=licitacoes-ai/0.1.0
HEURISTIC_VALOR_MINIMO=10000
# Fontes ligadas (vírgula). Desligue uma que esteja quebrando sem mexer no código.
FONTES=pncp,querido_diario,petronect,paradigma,gobuyer

# Filtros heurísticos extras (UF / órgãos / regex de objeto) ficam em
# config/filtros.json — editável sem rebuild.

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=*

# Scheduler (cron in-process). SCHEDULER_ENABLED=false desliga o cron;
# SCHEDULER_CRON aceita sintaxe padrão (5 campos). Default: 06:00 e 18:00.
SCHEDULER_ENABLED=true
SCHEDULER_CRON=0 6,18 * * *
SCHEDULER_TIMEZONE=America/Sao_Paulo

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
